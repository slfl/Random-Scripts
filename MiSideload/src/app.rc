#include <windows.h>

1 24 "app.manifest"
1 ICON "app.ico"

/* firmware search input dialog */
100 DIALOGEX 0, 0, 272, 76
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Search firmware"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Model, codename or version:", 102, 8, 8, 256, 18
    EDITTEXT        101, 8, 28, 256, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK", IDOK, 160, 52, 50, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 214, 52, 50, 16
END

/* firmware results / choose dialog */
110 DIALOGEX 0, 0, 336, 226
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Choose firmware"
FONT 9, "Segoe UI"
BEGIN
    LTEXT       "Choose a version:", 203, 8, 6, 320, 10
    LISTBOX     201, 8, 18, 320, 152, LBS_NOTIFY | WS_VSCROLL | WS_BORDER
    LTEXT       "Region:", 206, 8, 178, 40, 10
    COMBOBOX    205, 46, 176, 84, 200, CBS_DROPDOWNLIST | WS_VSCROLL
    LTEXT       "Source:", 204, 140, 178, 40, 10
    COMBOBOX    202, 178, 176, 150, 200, CBS_DROPDOWNLIST | WS_VSCROLL
    DEFPUSHBUTTON "Download", IDOK, 220, 202, 54, 16
    PUSHBUTTON    "Cancel", IDCANCEL, 278, 202, 50, 16
END
